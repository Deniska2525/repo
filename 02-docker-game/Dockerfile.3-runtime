# Подход 3: игра собирается при СТАРТЕ контейнера.
# В образе nginx, node, pnpm и исходники; при запуске команда CMD ставит зависимости,
# собирает игру, копирует её в nginx и запускает его. Пока сборка идёт, сайт не отвечает.
FROM nginx:alpine
RUN apk add --no-cache nodejs npm && npm install -g pnpm
ENV HUSKY=0 CI=true
WORKDIR /zigzag
COPY zigzag/ /zigzag/
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=300s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
CMD ["sh", "-c", "pnpm install --frozen-lockfile --config.strict-dep-builds=false ; pnpm build && cp -r dist/. /usr/share/nginx/html/ && exec nginx -g 'daemon off;'"]

