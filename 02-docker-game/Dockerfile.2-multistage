# Подход 2: игра собирается при сборке образа (multi-stage).

FROM node:22-alpine AS build
RUN npm install -g pnpm
ENV HUSKY=0 CI=true
WORKDIR /zigzag
COPY zigzag/ /zigzag/
RUN pnpm install --frozen-lockfile --config.strict-dep-builds=false ; pnpm build

FROM nginx:alpine
COPY --from=build /zigzag/dist/ /usr/share/nginx/html/
EXPOSE 80
